# Copie este arquivo para .env e preencha. O .env NÃO vai para o Git.

# --- Banco de dados (PostgreSQL) ---
# Ex.: Neon, Supabase, Railway ou um Postgres local.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/barberflow

# --- Clerk (login) — https://dashboard.clerk.com → API Keys ---
# A mesma publishable key vai nas duas variáveis (front e API).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# --- Portas (opcional) ---
# PORT=8080        # API (e o app inteiro em produção)
# WEB_PORT=5173    # Vite em desenvolvimento

# --- Opcional ---
# CORS_ORIGIN=https://meu-front.com   # só se o front ficar em outro domínio
# LOG_LEVEL=info
